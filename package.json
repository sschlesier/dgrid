{
  "name": "dgrid-v2",
  "version": "1.6.0",
  "description": "Modern MongoDB GUI with AI-native development",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "build": "tauri build",
    "build:frontend": "vite build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit && tsc --noEmit -p src",
    "lint": "eslint . --ext .ts,.js,.svelte",
    "lint:fix": "eslint . --ext .ts,.js,.svelte --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm type-check && pnpm lint && pnpm test run && pnpm build:frontend && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "version": "tsx scripts/sync-version.ts",
    "release": "tsx scripts/release.ts",
    "prepare": "husky",
    "tauri": "tauri",
    "e2e": "node scripts/run-tauri-e2e.mjs",
    "e2e:ci": "node scripts/run-tauri-e2e.mjs --ci",
    "e2e:install-driver": "cargo install tauri-webdriver --version 0.2.0 --locked",
    "e2e:smoke": "node scripts/run-tauri-e2e.mjs --spec tests/webdriver/specs/smoke.e2e.mjs"
  },
  "keywords": [
    "mongodb",
    "gui",
    "tauri",
    "svelte"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@replit/codemirror-vim": "^6.4.0",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-dialog": "~2.8.0",
    "@tauri-apps/plugin-opener": "~2.6.0",
    "codemirror": "^6.0.2",
    "svelte": "^5.57.1",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "~2.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "expect-webdriverio": "^5.7.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "mongodb": "^6.21.0",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "webdriverio": "^9.32.0"
  },
  "pnpm": {
    "overrides": {
      "mocha>serialize-javascript": "^7.0.3"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-7pqw-9j4j-h8q3",
        "GHSA-jmr9-qjv8-65gv"
      ]
    }
  }
}
