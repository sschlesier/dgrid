#!/usr/bin/env bash
# Show open tickets grouped by pipeline stage (their br status).
#
# Usage: br-stages
#
# needs-clarification is listed first because it is waiting on a human; open is
# the captured stage.
set -euo pipefail

blocked=$(br blocked --json | jq -c '(if type == "array" then . else .issues end)
    | map({ key: .id, value: .blocked_by[0] }) | from_entries')

br list --json --limit 0 | jq -r --argjson blocked "$blocked" '
    ["needs-clarification", "open", "triaged", "refined", "agent-ready", "in_progress", "review"] as $order
    | .issues
    | map(select(.status as $s | $order | index($s))
        | . + { note: (if .status == "agent-ready" and $blocked[.id] then "  (blocked by \($blocked[.id]))" else "" end) })
    | sort_by((.status as $s | $order | index($s)), .priority, .id)
    | group_by(.status as $s | $order | index($s))
    | map("== \(.[0].status) (\(length)) ==\n"
        + (map("  \((.id + "          ")[0:10]) P\(.priority)  \(.title)\(.note)") | join("\n")))
    | join("\n\n")
    | if . == "" then "No open tickets" else . end'
