#!/usr/bin/env bash
# Check issues against the structural Definition of Ready.
#
# Usage: br-lint [--all] [id...]
#
# With no ids, lints open issues labeled stage:refined or stage:agent-ready.
# --all lints every issue that is not closed. Exits 1 if any issue has a FAIL.
#
# FAIL: empty outcome (description before its first ## heading), empty acceptance
#       criteria, missing/empty "## Verification" in the description, type epic,
#       multiple stage labels. (br itself refuses dependency cycles.)
# WARN: placeholder text (TBD/TODO/???) in a required part, acceptance criteria
#       with no list items.
set -euo pipefail

mode=default
ids=()
for arg in "$@"; do
    case "$arg" in
        --all) mode=all ;;
        -h|--help) sed -n '2,13s/^# \{0,1\}//p' "$0"; exit 0 ;;
        *) ids+=("$arg") ;;
    esac
done

if [[ ${#ids[@]} -eq 0 ]]; then
    while IFS= read -r id; do ids+=("$id"); done < <(br list --json --limit 0 | jq -r --arg mode "$mode" '
        .issues[]
        | select(if $mode == "all" then .status != "closed"
                 else .status == "open" and any(.labels[]?; . == "stage:refined" or . == "stage:agent-ready") end)
        | .id')
fi
[[ ${#ids[@]} -gt 0 ]] || { echo "No issues to lint"; exit 0; }

br show "${ids[@]}" --json | jq -r '
    def strip: gsub("^\\s+|\\s+$"; "");
    def outcome: ("\n" + (.description // "")) | split("\n## ")[0] | strip;
    def verification:
        (.description // "")
        | (capture("(^|\\n)## Verification[^\\n]*\\n(?<body>[\\s\\S]*?)(\\n## |\\z)").body // "")
        | strip;
    def placeholder: test("TBD|TODO|\\?\\?\\?");

    map(
        (.acceptance_criteria // "" | strip) as $ac
        | ([.labels[]? | select(startswith("stage:"))] | length) as $nstage
        | ([
            (if outcome == "" then "FAIL empty description (outcome)" else empty end),
            (if $ac == "" then "FAIL empty acceptance criteria" else empty end),
            (if verification == "" then "FAIL missing or empty ## Verification" else empty end),
            (if .issue_type == "epic" then "FAIL type is epic (split it into tasks)" else empty end),
            (if $nstage > 1 then "FAIL multiple stage labels" else empty end)
          ]) as $fails
        | ([
            ([ (if outcome | placeholder then "description" else empty end),
               (if $ac | placeholder then "acceptance criteria" else empty end),
               (if verification | placeholder then "Verification" else empty end) ]
             | if length > 0 then "WARN placeholder text in " + join(", ") else empty end),
            (if $ac != "" and ($ac | test("(^|\\n)\\s*([-*+]|[0-9]+\\.)\\s") | not)
             then "WARN acceptance criteria have no list items" else empty end)
          ]) as $warns
        | { failed: ($fails | length > 0),
            text: ("\(.id) \(if ($fails | length) > 0 then "FAIL" else "ok" end)  \(.title)"
                   + ([$fails[], $warns[]] | map("\n  " + .) | join(""))) }
    )
    | (map(.text) | join("\n")), (if any(.failed) then "__FAILED__" else empty end)
' | {
    failed=0
    while IFS= read -r line; do
        if [[ "$line" == "__FAILED__" ]]; then failed=1; else echo "$line"; fi
    done
    exit "$failed"
}
